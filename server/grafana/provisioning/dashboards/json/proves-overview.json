{
  "uid": "proves-yamcs-overview",
  "title": "PROVES Yamcs Overview",
  "description": "Live Yamcs link rates, JVM, commanding, events, and alarms via the JAOPS Yamcs plugin.",
  "tags": ["yamcs", "proves", "jaops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "liveNow": true,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "TM ingest rate",
      "description": "Bytes per second into UDP_TM_IN (gateway → Yamcs).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "jaops-yamcs-datasource", "uid": "jaops-yamcs-main" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "jaops-yamcs-datasource", "uid": "jaops-yamcs-main" },
          "type": "plot",
          "endpoint": "fprime_realtime",
          "parameter": "/yamcs/proves-central/links/UDP_TM_IN/dataInRate",
          "asVariable": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
