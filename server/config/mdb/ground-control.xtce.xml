<?xml version='1.0' encoding='UTF-8'?>
<SpaceSystem name="Ground" xmlns="http://www.omg.org/spec/XTCE/20180204">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <StringParameterType name="StationNameType">
        <StringDataEncoding>
          <SizeInBits>
            <Fixed>
              <FixedValue>1024</FixedValue>
            </Fixed>
          </SizeInBits>
        </StringDataEncoding>
      </StringParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="ActiveTxStation" parameterTypeRef="StationNameType">
        <LongDescription>
          Name of the ground station used for telecommand uplink. Set this in
          the Yamcs UI (or via the gateway at :8091) to choose which registered
          station receives commands.
        </LongDescription>
        <ParameterProperties dataSource="local"/>
      </Parameter>
    </ParameterSet>
  </TelemetryMetaData>
</SpaceSystem>
